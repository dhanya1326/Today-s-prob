import time

# Rabin-Karp Algorithm
def rabin_karp(text, pattern):
    d = 256
    q = 101

    n = len(text)
    m = len(pattern)

    p_hash = 0
    t_hash = 0
    h = 1

    positions = []

    # Calculate h = pow(d, m-1) % q
    for i in range(m - 1):
        h = (h * d) % q

    # Initial hash values
    for i in range(m):
        p_hash = (d * p_hash + ord(pattern[i])) % q
        t_hash = (d * t_hash + ord(text[i])) % q

    start_time = time.perf_counter_ns()

    # Slide pattern over text
    for i in range(n - m + 1):

        # If hash values match
        if p_hash == t_hash:

            match = True

            for j in range(m):
                if text[i + j] != pattern[j]:
                    match = False
                    break

            if match:
                positions.append(i)

        # Calculate next window hash
        if i < n - m:
            t_hash = (d * (t_hash - ord(text[i]) * h) +
                      ord(text[i + m])) % q

            if t_hash < 0:
                t_hash += q

    end_time = time.perf_counter_ns()

    execution_time = end_time - start_time

    return positions, execution_time


# Main Program
text = input("Enter document text:\n")
pattern = input("Enter pattern to search:\n")

positions, exec_time = rabin_karp(text, pattern)

print("\n--- Search Result ---")

if positions:
    print("Pattern Found!")
    print("Positions:", positions)
    print("Occurrences:", len(positions))
else:
    print("Pattern Not Found!")

print("Execution Time:", exec_time, "nanoseconds")
