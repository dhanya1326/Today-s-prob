import time


# --------------------------------------------------
# KMP PATTERN SEARCHING ALGORITHM
# --------------------------------------------------

def KMP_Search(pattern, text):

    pattern_length = len(pattern)
    text_length = len(text)

    # Create LPS Array
    lps = [0] * pattern_length

    # Variables
    text_index = 0
    pattern_index = 0

    found_positions = []
    total_comparisons = 0

    # Build LPS Array
    build_LPS_Array(pattern, pattern_length, lps)

    print("\nLPS ARRAY :", lps)

    # Start Searching
    while text_index < text_length:

        total_comparisons += 1

        # Character Match
        if pattern[pattern_index] == text[text_index]:

            text_index += 1
            pattern_index += 1

        # Full Pattern Found
        if pattern_index == pattern_length:

            position = text_index - pattern_index

            found_positions.append(position)

            print("\nPattern found at index :", position)

            pattern_index = lps[pattern_index - 1]

        # Mismatch Condition
        elif (text_index < text_length and
              pattern[pattern_index] != text[text_index]):

            if pattern_index != 0:

                pattern_index = lps[pattern_index - 1]

            else:

                text_index += 1

    return found_positions, total_comparisons


# --------------------------------------------------
# FUNCTION TO BUILD LPS ARRAY
# --------------------------------------------------

def build_LPS_Array(pattern, pattern_length, lps):

    previous_length = 0

    lps[0] = 0

    current = 1

    while current < pattern_length:

        if pattern[current] == pattern[previous_length]:

            previous_length += 1

            lps[current] = previous_length

            current += 1

        else:

            if previous_length != 0:

                previous_length = lps[previous_length - 1]

            else:

                lps[current] = 0

                current += 1


# --------------------------------------------------
# MAIN PROGRAM
# --------------------------------------------------

print("\n==========================================")
print("        KMP SEARCH ANALYSIS SYSTEM")
print("==========================================\n")

txt = input("Enter text:\n\n")

pat = input("\nEnter pattern:\n\n")

# Start Time
start_time = time.perf_counter_ns()

# Call Function
positions, comparisons = KMP_Search(pat, txt)

# End Time
end_time = time.perf_counter_ns()

execution_time = end_time - start_time


# --------------------------------------------------
# DISPLAY FINAL REPORT
# --------------------------------------------------

print("\n==========================================")
print("              SEARCH REPORT")
print("==========================================\n")

print("TEXT LENGTH           :", len(txt))
print("PATTERN LENGTH        :", len(pat))

print("\nPATTERN SEARCHED      :", pat)

print("\n------------------------------------------")

if positions:

    print("SEARCH STATUS         : FOUND")
    print("MATCH POSITIONS       :", positions)
    print("TOTAL OCCURRENCES     :", len(positions))

else:

    print("SEARCH STATUS         : NOT FOUND")

print("------------------------------------------")

print("TOTAL COMPARISONS     :", comparisons)

print("EXECUTION TIME        :",
      execution_time,
      "nanoseconds")

print("\n==========================================")
print("         SEARCH COMPLETED")
print("==========================================")
