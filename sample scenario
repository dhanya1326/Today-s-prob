_FILLERS = ("algorithm data structure function variable loop condition iteration pointer "
            "array list node graph tree stack queue heap memory cache register processor "
            "network protocol packet byte bit flag compiler linker debugger runtime").split()

def _rand_sent() -> str:
    return ' '.join(random.choices(_FILLERS, k=random.randint(10, 20))).capitalize() + '.'

def generate_documents(n: int = 30, copy_ratio: float = 0.40) -> dict:
    docs = {}
    n_copied = int(n * copy_ratio)
    for i in range(1, n + 1):
        paras = [_rand_sent() + ' ' + _rand_sent()
                 for _ in range(random.randint(4, 8))]
        if i <= n_copied:
            for defn in random.sample(_TECH_DEFS, k=random.randint(1, 3)):
                paras.insert(random.randint(0, len(paras)), defn)
        docs[f"student_{i:03d}.txt"] = '\n\n'.join(paras)
    return docs


